# TaskToggle Environment Variables
# For real-time database synchronization with Supabase, add these:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Supabase service role key for backend serverless functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
